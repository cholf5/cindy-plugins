{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.143",
  "id": "open-in",
  "name": "Open In",
  "description": "在输入框下方的状态栏用本机第三方应用打开当前项目目录，也可以复制目录路径；自动检测已安装的编辑器、IDE、终端和文件管理器。",
  "whenToUse": "想把当前任务的项目目录在 VS Code、Cursor、其他 IDE、终端或文件管理器里打开，或想复制目录路径时找我；只支持本机项目，远程任务不适用。",
  "version": "1.1.1",
  "entry": "main.js",
  "launch": "resident",
  "command": "openin",
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json"
  },
  "readme": {
    "en": "README.md",
    "zh-CN": "README.zh-CN.md"
  },
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "resident"
  },
  "tools": [
    {
      "name": "list_apps",
      "description": "列出执行电脑上已安装、可用于打开项目目录的应用（编辑器、IDE、终端、Git 客户端、文件管理器）。传入项目目录时会同时判断是否为 C# 项目、Git 仓库。仅供插件菜单页面调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "title": "项目目录",
            "description": "当前任务的项目目录绝对路径；用于判断是否显示仅在 C# 项目中可用的应用。"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "open_in",
      "description": "用本机已安装的指定应用打开任务的项目目录。仅供插件菜单页面调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "maxLength": 64,
            "title": "应用标识",
            "description": "list_apps 返回的应用 id。"
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "title": "项目目录",
            "description": "当前任务的项目目录绝对路径。"
          }
        },
        "required": ["app", "path"],
        "additionalProperties": false
      }
    }
  ],
  "mcpApps": {
    "ui": {
      "resources": [
        {
          "uri": "ui://open-in/menu",
          "file": "ui/menu.html",
          "prefersBorder": false,
          "csp": {
            "connectDomains": [],
            "resourceDomains": []
          }
        }
      ],
      "tools": {
        "list_apps": { "resourceUri": "ui://open-in/menu", "visibility": ["app"] },
        "open_in": { "resourceUri": "ui://open-in/menu", "visibility": ["app"] }
      }
    },
    "host": {
      "views": [
        {
          "id": "menu",
          "title": "Open in",
          "resourceUri": "ui://open-in/menu",
          "scope": "task"
        }
      ],
      "contributions": [
        {
          "id": "open-in",
          "title": "Open in",
          "position": "statusbar",
          "view": "menu",
          "presentation": "popover",
          "icon": "folder"
        }
      ],
      "capabilities": ["context"]
    }
  }
}
